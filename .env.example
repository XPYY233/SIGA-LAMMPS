# Copy to `.env` and fill in. `.env` is git-ignored — never commit real values.
# Loaded by config/loader.py (local execution + benchmark) and hpc/ssh_client.py.

# ---------------------------------------------------------------- LLM
# DeepSeek API credential used by the harness. Never needed by the adapter itself.
DEEPSEEK_API_KEY=
# Optional: OpenAI-compatible proxy instead of the default DeepSeek endpoint.
# DEEPSEEK_BASE_URL=
# Model under test. Held IDENTICAL across every benchmark configuration.
DSH_MODEL=deepseek-v4-flash

# ---------------------------------------------------------------- HPC (sy_hl_login)
# ALWAYS the alias `sy_hl_login`. All SSH/SFTP/sbatch traffic goes through it;
# there is no fallback login node and none should be added. The certificate is
# issued to one user and authenticates only here.
SIGA_HPC_HOST=sy_hl_login
# Optional explicit overrides; leave empty to let ~/.ssh/config decide.
SIGA_HPC_USER=
SIGA_HPC_PORT=22
# Path to the PRIVATE key. The path is config, the key material is not.
SIGA_HPC_KEY_PATH=~/.ssh/id_ed25519
# Passphrase for the key, if any. Prefer an ssh-agent; leave empty to use the agent.
SIGA_HPC_KEY_PASSPHRASE=

# Remote sandbox root. ALL remote file operations are confined beneath this path.
SIGA_HPC_WORKSPACE=/scratch/$USER/siga-lammps

# ---------------------------------------------------------------- SLURM
SIGA_SLURM_PARTITION=
SIGA_SLURM_ACCOUNT=
# LAMMPS is loaded via `module load <name>`, or invoked by absolute path.
SIGA_LAMMPS_MODULE=
SIGA_LAMMPS_BIN=lmp

# Resource ceilings. The agent may REQUEST less; it can never exceed these.
SIGA_SLURM_MAX_NODES=1
SIGA_SLURM_MAX_NTASKS=64
SIGA_SLURM_MAX_WALLTIME=02:00:00

# ---------------------------------------------------------------- local LAMMPS
# Local executable used by the offline validation / smoke-test stage.
SIGA_LAMMPS_LOCAL_BIN=lmp
