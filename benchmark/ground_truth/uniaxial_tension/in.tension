# Uniaxial tension with lateral relaxation — reference implementation.
#
# The barostat is coupled to x and y ONLY. Coupling it to z as well would let it
# fight `fix deform` for control of the same dimension, applying the strain
# twice and making the measured stress meaningless.

units           lj
atom_style      atomic
boundary        p p p

lattice         fcc 0.85
region          box block 0 6 0 6 0 6
create_box      1 box
create_atoms    1 box
mass            1 1.0

pair_style      lj/cut 2.5
pair_coeff      1 1 1.0 1.0 2.5

velocity        all create 0.5 87287 loop geom
neighbor        0.3 bin
neigh_modify    delay 0 every 20 check no

# npt is the integrator here; adding a separate nve would double-integrate.
fix             1 all npt temp 0.5 0.5 0.5 x 0 0 1.0 y 0 0 1.0
fix             2 all deform 1 z erate 0.001

timestep        0.005
thermo          100
thermo_style    custom step temp press etotal lz
run             5000
