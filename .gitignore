# ---- secrets (NEVER commit) ----
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
.credentials.yaml
secrets.yaml
config/local.yaml
config/*.local.yaml

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- Node ----
node_modules/
dist/
build/
lib/
*.tsbuildinfo

# ---- generated artifacts (regenerable, kept out of git) ----
# Isolated harness home used for development and tests. Keeping DSH_HOME inside
# the workspace means testing never writes to the user's real ~/.dsh.
.dsh-dev/
.dsh-web/
# Cordis patch overlay: holds absolute checkout paths, so it is generated by
# harness/make_patch.py rather than committed.
harness/siga-patch.yml
# Runtime workspaces: generated LAMMPS inputs, logs, dump files.
workspace/*
!workspace/.gitkeep
# All generated data: the built index, the embedding-model cache, raw corpora.
# Rebuild with `python -m adapter.cli build-index`.
data/

# Benchmark run outputs (per-run artifacts are large; summaries are committed).
benchmark/runs/*
!benchmark/runs/.gitkeep

# ---- LAMMPS run residue ----
log.lammps
log.*.lammps
*.dump
*.restart
*.restart.*
*.bin
*.lammpstrj
*.dat.tmp
screen.*
slurm-*.out
slurm-*.err

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
*.swp
